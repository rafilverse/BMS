# Server Port
PORT=3850

# Google Gemini API Key (Required for AI reasoning, threat analysis & speech synthesis)
# Obtain from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# DetectifAI API Credentials (Required for Deepfake Detection & Voice Biometrics)
# Obtain from: https://detectif.ai/
DETECTIFAI_API_KEY=your_detectifai_api_key_here
DETECTIFAI_BASE_URL=https://platform.detectif.ai/v1

# Optional Fallback / Multi-model Reasoning via OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=liquid/lfm-2.5-2.6b:free
